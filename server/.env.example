# Copy this file to .env and fill it in. .env is gitignored, so the key never gets committed.

# Free key from Google AI Studio
GEMINI_API_KEY=

# Flash-Lite answers in about 1s. Flash allowed only 5 requests per minute on the free tier, which auto transcribe hits fast.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=8787
